{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rust SVG Editor",
  "version": "0.1.0",
  "identifier": "com.rust-svg-editor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rust SVG Editor",
        "maximized": true,
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "assets/fonts/OFL.txt"
    ]
  }
}
